#!/bin/bash

# Set password length (default 16, or use first argument)
LENGTH=${1:-16}

# Define character sets
LETTERS='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
NUMBERS='0123456789'
LIMITED_SPECIAL='!@#$%^&*'
ALL_SPECIAL='!@#$%^&*()-_=+[]{}|;:,.<>?/~`'

# Function to generate random password
generate_password() {
    local charset="$1"
    local length="$2"
    local password=""

    for ((i=0; i<length; i++)); do
        # Generate random index
        local rand_index=$((RANDOM % ${#charset}))
        # Append character at random index
        password+="${charset:$rand_index:1}"
    done

    echo "$password"
}

# Generate all 5 password types
echo "1. Letters only:                           $(generate_password "$LETTERS" "$LENGTH")"
echo "2. Numbers only:                           $(generate_password "$NUMBERS" "$LENGTH")"
echo "3. Letters + Numbers:                      $(generate_password "${LETTERS}${NUMBERS}" "$LENGTH")"
echo "4. Letters + Numbers + Limited Special:    $(generate_password "${LETTERS}${NUMBERS}${LIMITED_SPECIAL}" "$LENGTH")"
echo "5. All characters:                         $(generate_password "${LETTERS}${NUMBERS}${ALL_SPECIAL}" "$LENGTH")"
